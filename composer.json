{
    "name": "app/modular-monolith",
    "type": "project",
    "description": "Modular Monolith with DDD and Event Sourcing on Laravel 12",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "spatie/laravel-event-sourcing": "^7.0",
        "temporal/sdk": "^2.11",
        "laravel/octane": "^2.0",
        "sentry/sentry-laravel": "^4.0",
        "spatie/laravel-prometheus": "^1.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0",
        "phpmd/phpmd": "^2.15",
        "povils/phpmnd": "^3.5",
        "friendsofphp/php-cs-fixer": "^3.65",
        "squizlabs/php_codesniffer": "^3.11",
        "deptrac/deptrac": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "spiral/roadrunner-laravel"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "lint:fix": "vendor/bin/php-cs-fixer fix",
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html=storage/coverage",
        "deptrac": "vendor/bin/deptrac analyse --config-file=deptrac.yaml"
    }
}
